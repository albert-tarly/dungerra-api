{
  "name": "dungerra-api",
  "version": "2.0.0",
  "description": "Dungeon game with protobuf support",
  "main": "dist/index.ts",
  "scripts": {
    "build": "tsc",
    "proto:generate": "./scripts/generate-proto.sh",
    "proto:generate:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-proto.ps1"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@types/node": "^26.6.6",
    "protobufjs": "^7.2.0",
    "protoc": "^33.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true
  },
  "engines": {
    "node": ">=26"
  }
}
